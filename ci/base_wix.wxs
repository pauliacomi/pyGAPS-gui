<?define ProductName="pyGAPS-gui" ?>
<?define ProductVersion="{major}.{minor}.{micro}" ?>
<?define ProductVersionShort="{major}.{minor}" ?>
<?define UpgradeCode="3b4bdb09-19b1-4155-8799-d97fd49f6c05" ?>
<?define Manufacturer="Paul Iacomi" ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

    <!-- Section defined for entire product line -->
    <Package Name="$(var.ProductName)" Version="$(var.ProductVersion)"
             Manufacturer="$(var.Manufacturer)" Language="1033" Codepage="1252"
             UpgradeCode="$(var.UpgradeCode)" Scope="perUserOrMachine">
        <SummaryInformation Description="Windows Installer for $(var.ProductName) $(var.ProductVersion)" Keywords="Scientific, Adsorption, Isotherms" Manufacturer="$(var.Manufacturer)" />

        <!-- Package archive properties -->
        <Media Id="1" Cabinet="product.cab" EmbedCab="yes" CompressionLevel="high" />

        <!-- Path to upgrade pygaps -->
        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

        <!-- Where to install on the target machine -->
        <StandardDirectory Id="LocalAppDataFolder">
            <Directory Id="APPLICATIONFOLDER" Name="$(var.ProductName)" />
        </StandardDirectory>
        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="StartMenuShortcutDir" Name="$(var.ProductName)" />
        </StandardDirectory>

        <!-- Detailing the components of the main app directory -->
        <DirectoryRef Id="APPLICATIONFOLDER">
            <Component Id="MainExecutable" Guid="e1d55783-1707-485f-a9e8-a27ffb12c114">
                <File Name="pyGAPS-gui.exe" Source="{distdir}\pyGAPS-gui.exe" Id="MainExecutableExe" />
            </Component>
            {distfiles}
        </DirectoryRef>

        <!-- Detailing the components of Start Menu shortcut -->
        <DirectoryRef Id="StartMenuShortcutDir">
            <Component Id="ApplicationStartMenuShortcut" Guid="dd573908-bc26-4f88-9626-c15b87344df5">
                <Shortcut Id="ApplicationStartMenuShortcut" Name="$(var.ProductName)" Description="A framework for adsorption data processing." Target="[APPLICATIONFOLDER]pyGAPS-gui.exe" WorkingDirectory="APPLICATIONFOLDER" Icon="pyGAPSgui.exe" IconIndex="0" />
                <RemoveFolder Id="StartMenuShortcutDir" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\pyGAPS-gui" Name="installed" Type="integer" Value="1" KeyPath="yes" />
           </Component>
        </DirectoryRef>

        <!-- Detailing the components of Desktop shortcut -->
        <StandardDirectory Id="DesktopFolder">
            <Component Id="ApplicationDesktopShortcut" Guid="8c149b23-237a-4c41-83ec-c169f600c632">
                <Shortcut Id="ApplicationDesktopShortcut" Name="$(var.ProductName)" Description="A framework for adsorption data processing." Target="[APPLICATIONFOLDER]pyGAPS-gui.exe" WorkingDirectory="APPLICATIONFOLDER" Icon="pyGAPSgui.exe" IconIndex="0" />
                <RemoveFolder Id="DesktopFolder" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\pyGAPS-gui" Name="installed" Type="integer" Value="1" KeyPath="yes" />
           </Component>
        </StandardDirectory>

        <!-- Install features: product install, shortcut etc. -->
        <Feature Id="Complete" Title="$(var.ProductName)" Description="The complete package." Display="expand" ConfigurableDirectory="APPLICATIONFOLDER" Level="1">
            <!-- There's a single "feature": pygaps -->
            <Feature Id="MainProgram" Title="$(var.ProductName)" Description="Install pyGAPS-gui $(var.ProductVersion)" Level="1">
                <!-- Main executable and components -->
                <ComponentRef Id="MainExecutable" />
                {distcomponents}
                <!-- Install the shortcuts -->
                <ComponentRef Id="ApplicationStartMenuShortcut" />
                <ComponentRef Id="ApplicationDesktopShortcut" />
            </Feature>
        </Feature>

        <!-- This is install on a per-user basis -->
        <!-- This is to display a GUI for the installer -->
        <UI>
            <ui:WixUI Id="WixUI_Advanced" />
            <!-- https://stackoverflow.com/questions/56400973/why-does-my-msi-prompt-for-administrator-rights -->
            <Publish Dialog="InstallScopeDlg" Control="Next" Property="MSIINSTALLPERUSER" Value="1" Order="3" Condition="WixAppFolder = &quot;WixPerUserFolder&quot;" />
            <Publish Dialog="InstallScopeDlg" Control="Next" Property="MSIINSTALLPERUSER" Value="{{}}" Order="2" Condition="WixAppFolder = &quot;WixPerMachineFolder&quot;" />
            <Publish Dialog="InstallScopeDlg" Control="Next" Event="DoAction" Value="WixSetDefaultPerMachineFolder" Order="3" Condition="WixAppFolder = &quot;WixPerMachineFolder&quot;" />
            <Publish Dialog="InstallScopeDlg" Control="Next" Event="DoAction" Value="WixSetDefaultPerUserFolder" Order="3" Condition="WixAppFolder = &quot;WixPerUserFolder&quot;" />
        </UI>
        <UIRef Id="WixUI_ErrorProgressText" />
        <Property Id="ApplicationFolderName" Value="$(var.ProductName)" />
        <Property Id="WixAppFolder" Value="WixPerUserFolder" />
        <WixVariable Id="WixUILicenseRtf" Value="{distdir}/LICENSE.rtf" />
        <!-- <WixVariable Id="WixUIBannerBmp" Value="{distdir}/pygapsgui/resources/main_icon.bmp" /> -->

        <Icon Id="pyGAPSgui.exe" SourceFile="{distdir}/pygapsgui/resources/main_icon.ico" />
        <Property Id="ARPPRODUCTICON" Value="pyGAPSgui.exe" />

    </Package>
</Wix>
